---
// Background diorama — a "pop-up book": layered elements at different depths
// inside a 3D perspective stage that tilts toward the pointer, so things
// parallax / pop forward. Canopy blobs (far), drifting +/dot/sparkle
// particles (mid), depth-of-field leaves + a focal Russian Blue cat (the one
// raster, cat.webp) batting a yarn thread (front). Replicates the zustand demo
// technique (layered planes + pointer tilt + DoF). Freezes under reduced-motion.
---

<div class="scene" id="scene" aria-hidden="true">
  <div class="diorama" id="diorama">
    <div class="canopy">
      <svg viewBox="0 0 1600 460" preserveAspectRatio="xMidYMin slice">
        <path
          d="M0 0H1600V215C1512 300 1452 188 1372 252C1292 316 1214 196 1132 268C1050 338 988 212 904 282C824 348 762 224 680 286C600 346 540 212 460 278C380 334 318 200 240 266C160 322 92 210 0 262Z"
          fill="#070411"
        />
        <path
          d="M0 0H1600V150C1520 220 1450 130 1360 190C1250 262 1170 150 1070 210C980 264 900 156 800 214C710 266 630 150 530 206C440 256 360 150 250 200C150 246 80 150 0 196Z"
          fill="#0a0616"
          opacity="0.85"
        />
      </svg>
    </div>

    <div class="layer" style="--z: -70px"><canvas id="fx"></canvas></div>

    <div class="cat">
      <img class="cat__img" src="/cat.webp" alt="A Russian Blue cat reaching up to play" width="760" height="956" />
    </div>

    <div class="leaf leaf--tl"><svg viewBox="0 0 300 320">
      <defs><linearGradient id="lfa" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#13503a" /><stop offset="1" stop-color="#082c22" />
      </linearGradient></defs>
      <path d="M150 8C124 70 96 86 60 92C92 104 110 120 116 150C84 150 58 168 44 206C80 196 104 206 118 232C100 250 96 286 150 312C204 286 200 250 182 232C196 206 220 196 256 206C242 168 216 150 184 150C190 120 208 104 240 92C204 86 176 70 150 8Z" fill="url(#lfa)" />
      <path d="M150 36V300" stroke="#2c9069" stroke-width="3" opacity="0.45" />
    </svg></div>

    <div class="leaf leaf--bl"><svg viewBox="0 0 300 320">
      <defs><linearGradient id="lfb" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1c6b48" /><stop offset="1" stop-color="#0c3f2e" />
      </linearGradient></defs>
      <path d="M150 8C124 70 96 86 60 92C92 104 110 120 116 150C84 150 58 168 44 206C80 196 104 206 118 232C100 250 96 286 150 312C204 286 200 250 182 232C196 206 220 196 256 206C242 168 216 150 184 150C190 120 208 104 240 92C204 86 176 70 150 8Z" fill="url(#lfb)" />
      <path d="M150 36V300M150 120 96 96M150 120 204 96M150 186 70 162M150 186 230 162" stroke="#46c089" stroke-width="3" stroke-linecap="round" opacity="0.5" />
    </svg></div>

    <div class="leaf leaf--br"><svg viewBox="0 0 300 320">
      <defs><linearGradient id="lfc" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#1a6344" /><stop offset="1" stop-color="#0a3a2a" />
      </linearGradient></defs>
      <path d="M150 8C124 70 96 86 60 92C92 104 110 120 116 150C84 150 58 168 44 206C80 196 104 206 118 232C100 250 96 286 150 312C204 286 200 250 182 232C196 206 220 196 256 206C242 168 216 150 184 150C190 120 208 104 240 92C204 86 176 70 150 8Z" fill="url(#lfc)" />
      <path d="M150 36V300M150 120 96 96M150 120 204 96M150 186 70 162M150 186 230 162" stroke="#46c089" stroke-width="3" stroke-linecap="round" opacity="0.5" />
    </svg></div>
  </div>

  <!-- The yarn hangs on a full-viewport 3D twin layer that mirrors the diorama's
       tilt transform (same box, same .scene perspective), anchored to the cat's
       plane (translateZ(40px), matching .cat in global.css) — so the ball stays
       glued to the paw by transform alone, with no per-frame measurements.

       #threadClip is a stationary, untransformed box that only clips: its
       clip-path cuts the terminal's rectangle (plus a safety margin) out of the
       yarn, so the thread and ball can never paint across the terminal at any
       tilt, viewport size or zoom, while staying visible everywhere else.
       clip-path forces transform-style: flat, which would disconnect the layer
       from .scene's perspective, so the wrapper re-states that perspective
       (900px / 50% 45%) over the identical box — the frustum is unchanged. The
       hole is rebuilt from layout on resize/scroll/ResizeObserver only, never
       from the animation loop. -->
  <div id="threadClip" style="position:absolute;inset:0;perspective:900px;perspective-origin:50% 45%;clip-path:polygon(0px 0px,100% 0px,100% 100%,0px 100%)">
    <div id="threadLayer" style="position:absolute;inset:0;transform-style:preserve-3d">
      <div id="threadAnchor" style="position:absolute;top:0;left:0;transform:translateZ(40px)">
        <div class="thread" aria-hidden="true">
          <span class="thread__line"></span>
          <span class="thread__ball">
            <svg viewBox="0 0 56 56">
              <circle cx="28" cy="28" r="24" fill="#e0674f" />
              <path d="M8 22C22 14 36 18 47 30M7 34C20 46 38 42 49 30M18 9C20 30 26 48 19 53M38 10C36 31 31 49 38 54" fill="none" stroke="#b8412f" stroke-width="2" stroke-linecap="round" opacity="0.85" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="grain"></div>
</div>

<script>
  const diorama = document.getElementById("diorama") as HTMLElement;
  const cv = document.getElementById("fx") as HTMLCanvasElement;
  const fx = cv.getContext("2d")!;
  const threadLayer = document.getElementById("threadLayer") as HTMLElement;
  const thread = document.querySelector(".thread") as HTMLElement | null;
  const catImg = document.querySelector(".cat__img") as HTMLImageElement | null;
  const threadBall = thread?.querySelector(".thread__ball") as HTMLElement | null;

  // Reduced motion is live: a change event freezes or restores the loop.
  const reduceMql = window.matchMedia("(prefers-reduced-motion: reduce)");
  let reduce = reduceMql.matches;

  const PAW_X = 0.84, PAW_Y = 0.17; // raised-paw position within the cat image

  let W = 0, H = 0, CW = 0, CH = 0, DPR = 1;
  let threadW = 56, ballH = 50;

  type P = { x: number; y: number; t: number; s: number; a: number; vx: number; vy: number; ph: number; c: string };
  let parts: P[] = [];

  function seed() {
    const n = Math.min(150, Math.round((CW * CH) / 15000));
    parts = Array.from({ length: n }, () => {
      const roll = Math.random();
      // 0 cross, 1 dot, 2 sparkle
      const t = roll < 0.46 ? 0 : roll < 0.86 ? 1 : 2;
      const orange = t === 1 && Math.random() < 0.32;
      return {
        x: Math.random() * CW,
        y: Math.random() * CH,
        t,
        s: t === 2 ? 4 + Math.random() * 7 : 3 + Math.random() * 6,
        a: 0.3 + Math.random() * 0.6,
        vx: (Math.random() - 0.5) * 0.1,
        vy: -0.04 - Math.random() * 0.12,
        ph: Math.random() * Math.PI * 2,
        c: orange ? "#ff8a3d" : "#ffffff",
      };
    });
  }

  function size() {
    DPR = Math.min(window.devicePixelRatio || 1, reduce ? 1 : 1.5);
    W = window.innerWidth;
    H = window.innerHeight;
    CW = W * 1.52;
    CH = H * 1.52;
    cv.width = Math.floor(CW * DPR);
    cv.height = Math.floor(CH * DPR);
    fx.setTransform(DPR, 0, 0, DPR, 0, 0);
    seed();
    measure();
  }

  // Paw anchor in diorama-local coordinates. offset* describe the untransformed
  // layout box, so this is exact even while the diorama (and the twin layer) is
  // tilted; it runs only on load/resize, never per frame.
  function measure() {
    if (!catImg || !thread) return;
    let el: HTMLElement | null = catImg, ox = 0, oy = 0;
    while (el && el !== diorama) {
      ox += el.offsetLeft;
      oy += el.offsetTop;
      el = el.offsetParent as HTMLElement | null;
    }
    const pawX = ox + catImg.offsetWidth * PAW_X;
    const pawY = oy + catImg.offsetHeight * PAW_Y;
    threadW = thread.offsetWidth || 56;
    ballH = threadBall ? threadBall.offsetHeight : 50;
    thread.style.left = (pawX - threadW / 2).toFixed(1) + "px";
    thread.style.height = (pawY + ballH / 2).toFixed(1) + "px";
  }

  function cross(x: number, y: number, s: number) {
    fx.lineWidth = Math.max(1, s * 0.24);
    fx.lineCap = "round";
    fx.strokeStyle = "#ffffff";
    fx.beginPath();
    fx.moveTo(x - s, y); fx.lineTo(x + s, y);
    fx.moveTo(x, y - s); fx.lineTo(x, y + s);
    fx.stroke();
  }
  function sparkle(x: number, y: number, s: number) {
    const k = s * 0.18;
    fx.fillStyle = "#ffffff";
    fx.beginPath();
    fx.moveTo(x, y - s);
    fx.quadraticCurveTo(x + k, y - k, x + s, y);
    fx.quadraticCurveTo(x + k, y + k, x, y + s);
    fx.quadraticCurveTo(x - k, y + k, x - s, y);
    fx.quadraticCurveTo(x - k, y - k, x, y - s);
    fx.fill();
  }

  function draw(time: number, dt = 1) {
    fx.clearRect(0, 0, CW, CH);
    for (const p of parts) {
      if (!reduce) {
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        if (p.y < -12) p.y = CH + 12;
        if (p.x < -12) p.x = CW + 12; else if (p.x > CW + 12) p.x = -12;
      }
      const tw = reduce ? 1 : 0.55 + 0.45 * Math.sin(time * 0.0016 + p.ph);
      fx.globalAlpha = Math.min(1, p.a * tw);
      if (p.t === 0) cross(p.x, p.y, p.s);
      else if (p.t === 2) sparkle(p.x, p.y, p.s);
      else {
        fx.fillStyle = p.c;
        fx.beginPath();
        fx.arc(p.x, p.y, p.s * 0.42, 0, Math.PI * 2);
        fx.fill();
      }
    }
    fx.globalAlpha = 1;
  }

  // pointer + idle parallax tilt
  let mnx = 0, mny = 0, mx = 0, my = 0;
  window.addEventListener("pointermove", (e) => {
    mnx = (e.clientX / W) * 2 - 1;
    mny = (e.clientY / H) * 2 - 1;
  }, { passive: true });

  const start = performance.now();

  // The yarn hangs on a full-viewport 3D sibling that mirrors the diorama's
  // transform, so both planes rotate as one and the ball stays on the paw by
  // transform alone — no per-frame measurements.
  const STATIC_TILT = "rotateY(3deg)";
  function applyTilt(t: string) {
    diorama.style.transform = t;
    threadLayer.style.transform = t;
  }
  function tilt(t: number, dt: number) {
    const idleX = 0.16 * Math.sin(t * 0.00025);
    const idleY = 0.12 * Math.cos(t * 0.0002);
    const tx = mnx * 0.82 + idleX;
    const ty = mny * 0.82 + idleY;
    const f = 1 - Math.pow(1 - 0.06, dt); // frame-rate-independent smoothing
    mx += (tx - mx) * f;
    my += (ty - my) * f;
    applyTilt(
      `rotateX(${(-my * 4).toFixed(2)}deg) rotateY(${(mx * 7).toFixed(2)}deg) translate3d(${(mx * 10).toFixed(1)}px, ${(my * 6).toFixed(1)}px, 0)`,
    );
  }

  let rafId = 0, running = false, lastFrame = 0;
  function frame(now: number) {
    // delta-time in 60Hz steps; clamped so a stutter or resume can't jump
    const dt = lastFrame === 0 ? 1 : Math.min((now - lastFrame) / 16.667, 2);
    lastFrame = now;
    tilt(now - start, dt);
    draw(now, dt);
    rafId = requestAnimationFrame(frame);
  }
  function startLoop() {
    if (running || document.hidden) return;
    running = true;
    lastFrame = 0;
    rafId = requestAnimationFrame(frame);
  }
  function stopLoop() {
    running = false;
    cancelAnimationFrame(rafId);
  }

  size();
  window.addEventListener("resize", () => {
    size(); // resize clears the canvas — redraw the frozen scene under reduced motion
    if (reduce) {
      draw(0);
      applyTilt(STATIC_TILT);
    }
  }, { passive: true });

  // ---- terminal occlusion ---------------------------------------------------
  // The yarn layer is clipped by a hole cut to the terminal's rectangle (+ a
  // small margin), so the thread and ball can never paint across the terminal
  // at any tilt, viewport size or zoom. The hole is rebuilt from layout only
  // when layout can change (resize, ResizeObserver, scroll, CSS animations) —
  // the render loop never measures anything.
  const threadClip = document.getElementById("threadClip") as HTMLElement | null;
  const terminal = document.querySelector<HTMLElement>(".termwrap");
  const HOLE_MARGIN = 3;   // px of clearance around the terminal rectangle
  const REVEAL_SWEEP = 14; // px .reveal lifts the terminal on arrival

  let clipKey = "";

  function updateClip() {
    if (!threadClip || !terminal) return;
    const box = threadClip.getBoundingClientRect();
    if (!box.width || !box.height) return;
    // getBoundingClientRect speaks viewport (visual) px, but clip-path lengths
    // resolve in the wrapper's local px; the two differ under CSS zoom or any
    // scaled ancestor, so normalize the relative coords by the measured scale.
    const localW = threadClip.offsetWidth, localH = threadClip.offsetHeight;
    if (!localW || !localH) return;
    const sx = box.width / localW, sy = box.height / localH;
    const term = terminal.getBoundingClientRect();
    // While .reveal is still running, the terminal is on its way up; cover the
    // whole sweep (never measuring per frame) and re-cut when it lands.
    const arriving = terminal.getAnimations().some((a) => a.playState === "running");
    const pad = arriving ? REVEAL_SWEEP : 0;
    const x1 = (term.left - box.left) / sx - HOLE_MARGIN;
    const y1 = (term.top - box.top) / sy - HOLE_MARGIN - pad;
    const x2 = (term.right - box.left) / sx + HOLE_MARGIN;
    const y2 = (term.bottom - box.top) / sy + HOLE_MARGIN + pad;
    // Clamp the hole strictly inside the wrapper: a terminal fully outside the
    // viewport collapses to a degenerate hole, i.e. no clipping at all.
    const cx1 = Math.round(Math.min(Math.max(x1, 0.5), localW - 0.5) * 2) / 2;
    const cy1 = Math.round(Math.min(Math.max(y1, 0.5), localH - 0.5) * 2) / 2;
    const cx2 = Math.round(Math.min(Math.max(x2, 0.5), localW - 0.5) * 2) / 2;
    const cy2 = Math.round(Math.min(Math.max(y2, 0.5), localH - 0.5) * 2) / 2;
    const hole = cx2 - cx1 > 0.5 && cy2 - cy1 > 0.5;
    const key = `${box.width},${box.height},${localW},${localH}|` + (hole ? `${cx1},${cy1},${cx2},${cy2}` : "all");
    if (key === clipKey) return; // identical clip: skip the style write
    clipKey = key;
    if (!hole) {
      threadClip.style.clipPath = `polygon(0px 0px, ${localW}px 0px, ${localW}px ${localH}px, 0px ${localH}px)`;
      return;
    }
    // One rectilinear keyhole: outer box clockwise, hole anticlockwise, with
    // the zero-area seam along y = cy1, so every fill rule cuts the hole out.
    threadClip.style.clipPath =
      `polygon(0px 0px, ${localW}px 0px, ${localW}px ${localH}px, 0px ${localH}px, ` +
      `0px ${cy1}px, ${cx1}px ${cy1}px, ${cx1}px ${cy2}px, ${cx2}px ${cy2}px, ${cx2}px ${cy1}px, 0px ${cy1}px)`;
  }

  if (threadClip && terminal) {
    let clipQueued = false;
    const queueClip = () => {
      if (clipQueued) return; // coalesce resize/scroll/animation storms to one read
      clipQueued = true;
      requestAnimationFrame(() => {
        clipQueued = false;
        updateClip();
      });
    };
    updateClip(); // the first paint already has the hole cut
    new ResizeObserver(queueClip).observe(terminal);
    new ResizeObserver(queueClip).observe(threadClip);
    window.addEventListener("resize", queueClip, { passive: true });
    window.addEventListener("scroll", queueClip, { passive: true });
    // settle pass for the terminal's reveal (rise) and font/layout shifts
    document.addEventListener("animationstart", queueClip);
    document.addEventListener("animationend", queueClip);
    document.addEventListener("animationcancel", queueClip);
    document.fonts.ready.then(queueClip);
    window.addEventListener("load", queueClip);
  }

  // gentle user-triggered yarn feedback
  if (threadBall && thread) {
    threadBall.addEventListener("click", () => {
      thread.classList.remove("bounce");
      void thread.offsetWidth; // restart the animation on rapid clicks
      thread.classList.add("bounce");
    });
    thread.addEventListener("animationend", (e) => {
      if ((e as AnimationEvent).animationName === "threadBounce")
        thread.classList.remove("bounce");
    });
  }
  if (catImg && !catImg.complete) catImg.addEventListener("load", measure);
  window.addEventListener("load", measure);

  // Freeze/unfreeze live, without a reload.
  reduceMql.addEventListener("change", (e) => {
    reduce = e.matches;
    if (reduce) {
      stopLoop();
      draw(0);
      applyTilt(STATIC_TILT);
    } else {
      mx = 3 / 7; my = 0; // resume near the frozen pose (rotation matches; translation eases out)
      startLoop();
    }
  });

  // Pause while hidden; resume continues at the frozen state with no jump.
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) stopLoop();
    else if (!reduce) startLoop();
  });

  if (reduce) {
    draw(0);
    applyTilt(STATIC_TILT);
    // fully static: no rAF loop
  } else {
    startLoop();
  }
</script>
