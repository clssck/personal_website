---
import { SITE, PROJECTS, ABOUT, projectUrl } from "../lib/profile";

const reposDisplay = SITE.reposUrl.replace(/^https?:\/\//, "");
---

<section class="termwrap reveal" data-d="2">
  <h1 class="visually-hidden">{SITE.name} — {SITE.role}: {SITE.tagline}</h1>
  <div class="term" id="term">
    <div class="term__bar">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="term__title">visitor@janos — zsh</span>
    </div>
    <div class="term__screen" id="screen">
      <noscript>
        <div class="term__intro">
          <p class="term__name"><span class="grad">{SITE.name}</span></p>
          <p class="term__tag"><span class="k">{SITE.role}</span> — {SITE.tagline}</p>
          <nav class="term__links" aria-label="Shortcuts">
            <a href="#about">about</a>
            <a href="#projects">projects</a>
            <a href={SITE.reposUrl} target="_blank" rel="noopener noreferrer">repos</a>
            <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer">github</a>
          </nav>
          <details class="term__details" id="about">
            <summary>about</summary>
            {ABOUT.map((p) => <p>{p}</p>)}
          </details>
          <details class="term__details" id="projects">
            <summary>projects</summary>
            <ul>
              {PROJECTS.map((p) => (
                <li>
                  <a href={projectUrl(p.slug)} target="_blank" rel="noopener noreferrer">{p.name}</a>
                  <span> — {p.description}</span>
                </li>
              ))}
            </ul>
            <p>All public repos: <a href={SITE.reposUrl} target="_blank" rel="noopener noreferrer">{reposDisplay}</a></p>
          </details>
        </div>
      </noscript>
      <div id="out" role="log" aria-live="polite" aria-relevant="additions"></div>
      <form class="term__line" id="inputline" autocomplete="off" novalidate>
        <label class="prompt" for="cmd"><span class="u">visitor</span><span class="dim">@</span><span class="h">janos</span><span class="dim">:~$</span></label>
        <span class="cmdwrap"><input id="cmd" name="cmd" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="go" placeholder=" " aria-label="Terminal command" aria-describedby="terminal-hint" /><span class="ghost" id="ghost" aria-hidden="true"></span><span class="cursor" aria-hidden="true"></span></span>
      </form>
    </div>
    <div class="term__foot"><p class="hint" id="terminal-hint">psst — it's a real terminal. type <span class="a">help</span> and hit <kbd>↵</kbd></p></div>
  </div>
</section>

<script>
  import { SITE, PROJECTS, ABOUT, SKILLS, projectUrl } from "../lib/profile";
  import { loadRepos, FALLBACK_REPOS } from "../lib/github";
  import {
    completionFor,
    shouldInterceptTab,
    escapeHtml as esc,
    own,
    createHistory,
  } from "../lib/terminal";

  const term = document.getElementById("term") as HTMLElement;
  const out = document.getElementById("out") as HTMLElement;
  const view = document.getElementById("screen") as HTMLElement;
  const form = document.getElementById("inputline") as HTMLFormElement;
  const kbd = document.getElementById("cmd") as HTMLInputElement;
  const ghost = document.getElementById("ghost") as HTMLElement;

  const PROMPT =
    '<span class="u">visitor</span><span class="dim">@</span><span class="h">janos</span><span class="dim">:~$</span>&nbsp;';

  const ghDisplay = SITE.githubUrl.replace(/^https?:\/\//, "");
  const ghLink = `<a href="${SITE.githubUrl}" target="_blank" rel="noopener noreferrer">${esc(ghDisplay)}</a>`;
  const ext = (url: string, text: string) =>
    `<a href="${url}" target="_blank" rel="noopener noreferrer">${text}</a>`;

  function makeLine(html: string, cls?: string) {
    const d = document.createElement("div");
    d.className = "ln" + (cls ? " " + cls : "");
    d.innerHTML = html;
    return d;
  }
  function line(html: string, cls?: string) {
    const d = makeLine(html, cls);
    out.appendChild(d);
    return d;
  }
  function printLines(arr: string[] | null) {
    if (!arr) return;
    for (const l of arr) line(l);
  }
  const scrollDown = () => (view.scrollTop = view.scrollHeight);
  const pick = <T,>(a: T[]) => a[(Math.random() * a.length) | 0];

  const FORTUNES = [
    "There are only two hard things in CS: cache invalidation and naming things.",
    "“It works on my machine” is not a deployment strategy.",
    "Premature optimization is the root of all evil. — Knuth",
    "rm -rf doubts/",
    "A good UI is like a joke — if you have to explain it, it isn't that good.",
  ];

  const NEO_ART = [
    "   ╭───────────╮ ",
    "   │  ◠     ◠  │ ",
    "   │     ‿     │ ",
    "   ╰───────────╯ ",
    "      ║   ║      ",
    "   ═══╩═══╩═══   ",
  ];
  function neofetchBlock(): string {
    const row = (k: string, v: string) =>
      `<div class="neo__row"><dt>${k}</dt><dd>${v}</dd></div>`;
    return (
      `<div class="neo"><pre class="neo__art" aria-hidden="true">` +
      esc(NEO_ART.join("\n")) +
      `</pre><dl class="neo__kv">` +
      row("who", `<span class="grad">${esc(SITE.name)}</span>`) +
      row("role", esc(SITE.role)) +
      row("stack", "astro · ts · css3d/canvas") +
      row("site", "astro · static · no framework runtime") +
      row("github", ghLink) +
      `</dl></div>`
    );
  }

  function repoLines(
    repos: { name: string; url: string; description: string | null; language: string | null; archived: boolean; fork: boolean }[]
  ): string[] {
    const lines: string[] = [
      `<span class="dim">${repos.length} public repos, most recently pushed first —</span>`,
    ];
    for (const r of repos) {
      const flags =
        (r.archived ? ` <span class="dim">[archived]</span>` : "") +
        (r.fork ? ` <span class="dim">[fork]</span>` : "");
      const lang = r.language ? ` <span class="dim">· ${esc(r.language)}</span>` : "";
      lines.push(`▸ ${ext(r.url, `<b>${esc(r.name)}</b>`)}${flags}${lang}`);
      lines.push(
        r.description
          ? `  ${esc(r.description)}`
          : `  <span class="dim">(no description)</span>`
      );
    }
    lines.push(
      `<span class="dim">the full directory anytime:</span> ${ext(FALLBACK_REPOS, esc(FALLBACK_REPOS.replace(/^https?:\/\//, "")))}`
    );
    return lines;
  }

  type Cmd = (
    args: string[],
    rest: string,
    ctx: { id: number }
  ) => string[] | null;

  const aboutLines = (): string[] => [
    ...ABOUT,
    "",
    `For the greatest hits: <span class="a">projects</span>.`,
  ];
  const skillsLines = (): string[] => [
    "things i work with —",
    ...SKILLS.map((s) => `  ${s}`),
    "  <span class='dim'>curiosity &gt; frameworks</span>",
  ];
  const projectsLines = (): string[] => [
    "the curated five —",
    ...PROJECTS.flatMap((p) => [
      `  ▸ ${ext(projectUrl(p.slug), `<b>${esc(p.name)}</b>`)} — ${esc(p.description)}`,
    ]),
    "",
    `everything else lives in <span class="a">repos</span>.`,
  ];

  // Async output ownership: each run gets a token; results print only while
  // their token is still pending, so `clear` during a fetch drops the
  // late result instead of resurrecting it.
  let runSeq = 0;
  const pending = new Set<number>();

  const commands: Record<string, Cmd> = {
    help: () => [
      "available commands —",
      "  <span class='a'>whoami</span>     who am i",
      "  <span class='a'>about</span>      a little more",
      "  <span class='a'>skills</span>     what i work with",
      "  <span class='a'>projects</span>   the curated five",
      "  <span class='a'>repos</span>      every public repo, live from github",
      "  <span class='a'>github</span>     open my github",
      "  <span class='a'>neofetch</span>   the rundown",
      "  <span class='a'>ls</span> · <span class='a'>cat</span>   nose around files",
      "  <span class='a'>echo</span> · <span class='a'>date</span> · <span class='a'>fortune</span> · <span class='a'>clear</span>",
      "",
      "<span class='dim'>↑/↓ history · tab completes</span>",
    ],
    whoami: () => [
      `<span class='grad'>${esc(SITE.name)}</span> — ${esc(SITE.role)}`,
      esc(SITE.tagline),
      "",
      `→ ${ghLink}`,
    ],
    about: () => aboutLines(),
    skills: () => skillsLines(),
    projects: () => projectsLines(),
    repos: (_a, _r, ctx) => {
      const loading = line(`<span class="dim">fetching public repos from GitHub …</span>`);
      scrollDown();
      const id = ctx.id;
      pending.add(id);
      loadRepos().then((res) => {
        if (!pending.has(id)) return; // cleared while pending — stay silent
        pending.delete(id);
        const result = !res.ok
          ? [
              `<span class="err">${esc(res.message)}</span>`,
              `browse them directly: ${ext(res.fallback, esc(res.fallback.replace(/^https?:\/\//, "")))}`,
            ]
          : res.repos.length === 0
            ? [
                "no public repos on GitHub right now —",
                `meanwhile, the curated set is one <span class="a">projects</span> away.`,
              ]
            : repoLines(res.repos);
        // replace the loading placeholder in place, so the result stays
        // beside its command even if later commands ran while pending
        const frag = document.createDocumentFragment();
        for (const html of result) frag.appendChild(makeLine(html));
        out.insertBefore(frag, loading);
        loading.remove();
        scrollDown();
      });
      return null;
    },
    github: () => {
      window.open(SITE.githubUrl, "_blank", "noopener");
      return [`opening ${ghLink} …`];
    },
    ls: () => [
      "about.txt   skills.txt   projects.url   github.url   <span class='a'>secrets/</span>",
    ],
    cat: (args) => {
      const f = args[0];
      if (!f) return ["usage: cat <file>"];
      const files: Record<string, string[]> = {
        "about.txt": aboutLines(),
        "skills.txt": skillsLines(),
        "projects.url": PROJECTS.map((p) => projectUrl(p.slug)),
        "github.url": [SITE.githubUrl],
      };
      return (
        own(files, f) || [
          `<span class='err'>cat: ${esc(f)}: No such file or directory</span>`,
        ]
      );
    },
    neofetch: () => [neofetchBlock()],
    echo: (_a, rest) => [esc(rest || "")],
    date: () => [new Date().toString()],
    pwd: () => ["/home/janos"],
    fortune: () => [pick(FORTUNES)],
    sudo: () => [
      "<span class='err'>sudo: permission denied</span> — you're a guest here, but a welcome one.",
    ],
    secrets: () => ["<span class='dim'>nice try — nothing here but stardust.</span>"],
    history: () =>
      hist.length
        ? Array.from(
            { length: hist.length },
            (_, i) => `  ${i + 1}  ${esc(hist.at(i))}`
          )
        : ["(empty)"],
    clear: () => {
      pending.clear();
      out.innerHTML = "";
      return null;
    },
  };

  const COMMAND_NAMES = Object.keys(commands);
  const CAT_FILES = ["about.txt", "skills.txt", "projects.url", "github.url"];

  const hist = createHistory();
  let hi = 0;
  let draft = "";

  function syncWidth() {
    kbd.style.width = Math.max(2, kbd.value.length + 1) + "ch";
  }
  function updateGhost() {
    const completion = completionFor(kbd.value, COMMAND_NAMES, CAT_FILES);
    const capped = kbd.scrollWidth > kbd.clientWidth + 1;
    ghost.textContent =
      !capped && completion?.candidate
        ? completion.candidate.slice(completion.token.length)
        : "";
  }

  function acceptSuggestion() {
    if (!ghost.textContent) return false;
    const completion = completionFor(kbd.value, COMMAND_NAMES, CAT_FILES);
    if (!completion?.candidate) return false;
    setInput(completion.prefix + completion.candidate);
    caretEnd();
    updateGhost();
    return true;
  }

  function setInput(v: string) {
    kbd.value = v;
    syncWidth();
  }
  function caretEnd() {
    try {
      kbd.setSelectionRange(kbd.value.length, kbd.value.length);
    } catch {}
  }

  function run(raw: string) {
    line(PROMPT + esc(raw));
    const cmdText = raw.trim();
    const id = ++runSeq;
    if (cmdText) {
      hist.push(cmdText);
      const parts = cmdText.split(/\s+/);
      const name = parts[0].toLowerCase();
      const rest = cmdText.slice(parts[0].length).trim();
      const fn = own(commands, name);
      if (fn) printLines(fn(parts.slice(1), rest, { id }));
      else
        line(
          `<span class='err'>command not found: ${esc(name)}</span> — try <span class='a'>help</span>`
        );
    }
    draft = "";
    hi = hist.length;
    setInput("");
    ghost.textContent = "";
    scrollDown();
  }

  kbd.addEventListener("input", () => {
    syncWidth();
    updateGhost();
  });
  form.addEventListener("submit", (e) => {
    // Mobile keyboards submit the form ("go") — same as Enter.
    e.preventDefault();
    ghost.textContent = "";
    run(kbd.value);
  });
  kbd.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      if (e.isComposing) return;
      ghost.textContent = "";
      run(kbd.value);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (hist.length) {
        if (hi === hist.length) draft = kbd.value;
        hi = hist.step(hi, -1);
        setInput(hist.at(hi));
        caretEnd();
        updateGhost();
      }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (hist.length) {
        hi = hist.step(hi, 1);
        setInput(hi === hist.length ? draft : hist.at(hi));
        caretEnd();
        updateGhost();
      }
    } else if (e.key === "Escape") {
      e.preventDefault();
      ghost.textContent = "";
    } else if (
      e.key === "ArrowRight" &&
      !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey &&
      kbd.selectionStart === kbd.value.length
    ) {
      if (acceptSuggestion()) e.preventDefault();
    } else if (e.key === "Tab") {
      // Shift+Tab, modifiers, IME, empty/unmatched/exact input all escape
      // to native focus order — Tab is only ours when it completes or lists.
      if (!shouldInterceptTab(e, kbd.value, COMMAND_NAMES, CAT_FILES)) return;
      e.preventDefault();
      if (acceptSuggestion()) return;
      const completion = completionFor(kbd.value, COMMAND_NAMES, CAT_FILES);
      if (!completion) return;
      if (completion.matches.length === 1) {
        setInput(completion.prefix + completion.matches[0]);
        caretEnd();
        updateGhost();
      } else if (completion.matches.length > 1) {
        line(PROMPT + esc(kbd.value));
        line(esc(completion.matches.join("   ")));
        scrollDown();
      }
    }
  });

  const focusKbd = () => kbd.focus({ preventScroll: true });
  view.addEventListener("click", (e) => {
    // the prompt is the only interactive thing in the screen; clicks on it
    // (or anywhere else that owns focus) are left alone — and focusing here
    // is user-initiated, so it never summons a mobile keyboard on its own
    if ((e.target as HTMLElement).closest("a,button,input")) return;
    if (!String(window.getSelection())) focusKbd();
  });

  term.dataset.ready = "true";
  syncWidth();
</script>
